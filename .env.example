# Copie este arquivo para ".env" (ou ".env.local") e ajuste os valores.
# Nunca coloque segredos aqui: variáveis VITE_* ficam visíveis no navegador.

# URL base da API usada pelo frontend.
# Em desenvolvimento, deixe "/backend": o Vite repassa para a API (veja vite.config.ts).
# Em produção, use a URL real da API (ela precisa liberar CORS) ou um proxy reverso.
VITE_API_URL=/backend

# Endereço da contae-api para o proxy do Vite (somente desenvolvimento).
VITE_API_PROXY_TARGET=http://localhost:8080

# Exige login para acessar as telas internas?
# "false" enquanto a tela de login não estiver implementada; mude para "true" depois.
VITE_EXIGIR_LOGIN=false
